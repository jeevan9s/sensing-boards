	(text "VBATT_SENSE = V < 3.3V\n\nV = (R2 / R1 + R2) * VBATT\nR1 = 10k\nV = 2.8V (safe limit)\nVBATT = 3.7V\n\nR2 = (V * R1) / (VBATT - V) \nR2 = (2.8 * 10000) / (3.7 - 2.8) = 31k\nNearest resistor val is 30k"
		(exclude_from_sim no)
		(at 195.326 221.996 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "5eeadb2e-366b-4e17-820f-b70a0bc16394")
	)
	(text "π-Filter Ferrite Bead\n\nIsat = 1.5 * Inet\nIsat = 1.5 * 750 mA ≈ 1.5 A\n\nLow heat dissipation. \nDCR = 10 mohm\n\nP = I^2 * DCR = (1.5A)^2 * (0.05) = 0.1125 W (heat)"
		(exclude_from_sim no)
		(at 171.45 47.752 0)
